# ════════════════════════════════════════════════
#   CLASSROOM COMPANION — Git Ignore
#   What we never want in our repository
# ════════════════════════════════════════════════

# ── CRITICAL — Never commit these ────────────────
.env
*.pem
*.key
*_private_key*
*_secret*

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environment ───────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Testing ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Database ──────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ── Logs ──────────────────────────────────────────
*.log
logs/
log/

# ── Uploads / Media ───────────────────────────────
uploads/
media/
*.mp3
*.mp4
*.ogg
*.wav

# ── IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ── OS ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Docker ────────────────────────────────────────
.docker/

# ── Alembic ───────────────────────────────────────
alembic/versions/*.pyc

# ── Node (if any frontend tooling) ───────────────
node_modules/
npm-debug.log
yarn-error.log

# ── Deployment ────────────────────────────────────
.railway/
.render/
*.tfstate
*.tfstate.backup

# ── Misc ──────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/
test_connections.py